  {
   "id": 7,
   "title": "Tokens over time by model",
   "type": "timeseries",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "tl-pg"
   },
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 16,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "tl-pg"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroupAlias(created_at, '5m'), model AS metric, sum(input_tokens + output_tokens) AS tokens\nFROM llm_calls WHERE $__timeFilter(created_at)\nGROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "title": "Calls by purpose",
   "type": "piechart",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "tl-pg"
   },
   "description": "",
   "gridPos": {
    "x": 16,
    "y": 4,
    "w": 8,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "tl-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT purpose, count(*) AS calls FROM llm_calls GROUP BY 1 ORDER BY 2 DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": true
    },
    "pieType": "donut",
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "values": [
      "value"
     ]
    }
   }
  },
  {
   "id": 9,
   "title": "Latency and tokens by model",
   "type": "table",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "tl-pg"
   },
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "tl-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT provider, model, count(*) AS calls, round(avg(latency_ms)) AS avg_ms,\n       sum(input_tokens) AS input_tokens, sum(output_tokens) AS output_tokens, sum(cached_tokens) AS cached_tokens\nFROM llm_calls GROUP BY 1, 2 ORDER BY calls DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
