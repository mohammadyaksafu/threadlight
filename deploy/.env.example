# ThreadLight VPS settings. Copy to deploy/.env and fill in. Never commit the filled-in copy.
# Generate secrets with: openssl rand -hex 32

# --- Public address ---------------------------------------------------------
DOMAIN=threadlight.example.com
ACME_EMAIL=you@example.com
PUBLIC_BASE_URL=https://threadlight.example.com
CORS_ORIGINS=https://threadlight.example.com,https://mohammadyaksafu.github.io

# --- Admin tools (n8n, Langfuse, Grafana sub-domains) -------------------------
# your home/office IP range(s), space-separated CIDR
ADMIN_ALLOW=203.0.113.0/24
ADMIN_USER=admin
# caddy hash-password --plaintext '...'
ADMIN_PASSWORD_HASH=

# --- Models -----------------------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODE=live
PRIVATE_MODE=false
# 32 GB VPS: add qwen2.5:7b
OLLAMA_MODELS=llama3.2:3b bge-m3
OLLAMA_MEM=10g
RERANKER=bge
WITH_ML=1
REVIEW_THRESHOLD=0.85
QUERY_REWRITE=true

# --- Data stores ------------------------------------------------------------
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MINIO_ROOT_USER=threadlight
MINIO_ROOT_PASSWORD=
S3_BUCKET=threadlight

# --- Auth -------------------------------------------------------------------
JWT_SECRET=

# --- n8n --------------------------------------------------------------------
N8N_ENCRYPTION_KEY=
AUTOMATION_PASSWORD=
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Observability (docker compose --profile obs) ---------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-threadlight
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# exactly 64 hex characters
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_ADMIN_EMAIL=you@example.com
LANGFUSE_ADMIN_PASSWORD=
CLICKHOUSE_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# --- Backups ----------------------------------------------------------------
RCLONE_REMOTE=
